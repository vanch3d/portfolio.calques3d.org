{
  "$schema": "https://json-schema.org/draft/2020-12",
  "$id": "https://portfolio.calques3d.org/schemas/shared",
  "title": "Shared primitives",
  "description": "Reusable $defs referenced by all content schemas. Not a standalone schema.",
  "$defs": {
    "Period": {
      "type": "object",
      "description": "A time range with an optional end (null = ongoing)",
      "properties": {
        "start": {
          "type": "string",
          "description": "ISO year 'YYYY' or month 'YYYY-MM'",
          "pattern": "^[0-9]{4}(-[0-9]{2})?$"
        },
        "end": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}(-[0-9]{2})?$"
            },
            { "type": "null" }
          ],
          "description": "ISO year or month, or null if ongoing"
        }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "Coordinates": {
      "type": "object",
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "required": ["lat", "lng"],
      "additionalProperties": false
    },
    "MediaAssets": {
      "type": "object",
      "properties": {
        "cover": {
          "type": "string",
          "description": "Path relative to /public or absolute URL"
        },
        "gallery": {
          "type": "string",
          "description": "Piwigo album name/slug"
        },
        "slides": {
          "type": "string",
          "format": "uri",
          "description": "Speakerdeck URL"
        }
      },
      "additionalProperties": false
    },
    "ProjectLinks": {
      "type": "object",
      "properties": {
        "github": {
          "type": "array",
          "items": { "type": "string" },
          "description": "GitHub repo references e.g. 'owner/repo'"
        },
        "linkedin": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "external": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "live": {
          "type": "string",
          "format": "uri",
          "description": "Publicly accessible deployment URL"
        }
      },
      "additionalProperties": false
    },
    "SlugRef": {
      "type": "string",
      "description": "Slug reference to another content record",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "TagList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
