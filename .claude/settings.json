{
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true,
    "skill-creator@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/branch-guard/branch-guard.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/pre-commit-validate/pre-commit-validate.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/ts-guard/ts-guard.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/test-file-check/test-file-check.mjs"
          }
        ]
      }
    ]
  }
}
