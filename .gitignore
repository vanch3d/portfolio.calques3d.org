# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
id_rsa
id_ed25519

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
# .env.example is intentionally committed as a template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local planning notes (not for repo)
/.local/
/.idea/

# Claude Code — only local settings and generated symlinks are ignored; commands and rules are committed
/.claude/settings.local.json
/.claude/skills/

# Agent skills — canonical skill files; skills-lock.json is the reproducible manifest
# .agents/skills/ contains the actual SKILL.md files; .claude/skills/ contains machine-local symlinks to them
/.agents/
