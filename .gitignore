# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
id_rsa
id_ed25519

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
# .env.example is intentionally committed as a template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local planning notes (not for repo)
/.local/
/.idea/

# Claude Code — keep local/machine-specific config private
/.claude/settings.local.json

# Installed marketplace skills (reproducible from skills-lock.json)
# Use /* not / — ignoring the directory itself blocks negation rules from working
/.claude/skills/*
# Custom project-owned skills committed via explicit exceptions:
!/.claude/skills/mermaid
!/.claude/skills/pr-snapshots

# Test artefacts
/playwright-report/
/test-results/

# PR screenshots — uploaded to GitHub CDN, not committed to git
/.docs/screenshots/

# Impeccable — working directories (generated, not source of truth)
# .impeccable/surfaces/ IS committed — those are the direction contracts
/.impeccable/mocks/
/.impeccable/build/
/.impeccable/live/
/.impeccable/questions/
/.impeccable/hook.cache.json
