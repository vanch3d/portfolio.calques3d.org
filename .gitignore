# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
id_rsa
id_ed25519

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
# .env.example is intentionally committed as a template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local planning notes (not for repo)
/.local/
/.idea/

# Claude Code — keep local/machine-specific config private
/.claude/settings.local.json

# Installed marketplace skills (reproducible from .claude/skills.json manifest)
# Use /* not / — ignoring the directory itself blocks negation rules from working
/.claude/skills/*
# Project-owned skills and vendored marketplace skills committed via explicit exceptions:
!/.claude/skills/mermaid
!/.claude/skills/pr-snapshots
!/.claude/skills/pr-flow
!/.claude/skills/meriley-claude-code-skills-pr-description-writer

# Test artefacts
/playwright-report/
/test-results/
/cypress/screenshots/

# Impeccable — working directories (generated, not source of truth)
# .impeccable/surfaces/ IS committed — those are the direction contracts
/.impeccable/mocks/
/.impeccable/build/
/.impeccable/live/
/.impeccable/questions/
/.impeccable/hook.cache.json

# Graphify local token tracking only
/graphify-out/cache/
/graphify-out/cost.json

# Graphify machine-local state (absolute paths, not portable across machines)
/graphify-out/.graphify_python
/graphify-out/.graphify_root