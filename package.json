{
  "name": "nextjs-vanch-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "cypress",
      "esbuild",
      "msw",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:diagrams": "node .claude/skills/mermaid/scripts/validate-diagrams.mjs",
    "validate:workflow": "actionlint .github/workflows/ci.yml",
    "validate": "pnpm run validate:content && pnpm run validate:diagrams",
    "generate:types": "echo 'TODO: json-schema-to-typescript pipeline not yet configured'",
    "inspect:zotero": "tsx scripts/inspect-zotero.mjs",
    "inspect:zotero-archive": "tsx scripts/inspect-zotero-archive.mjs",
    "inspect:owncloud": "tsx scripts/inspect-owncloud.mjs",
    "test:zotero": "tsx scripts/test-zotero.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ct": "cypress run --component",
    "test:ct:open": "cypress open --component --browser chrome",
    "test:e2e": "start-server-and-test start http://localhost:3000 'cypress run --e2e'",
    "test:e2e:open": "start-server-and-test start http://localhost:3000 'cypress open --e2e --browser chrome'",
    "test:e2e:dev": "start-server-and-test dev http://localhost:3000 'cypress open --e2e --browser chrome'",
    "test:playwright": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@citation-js/core": "^0.8.2",
    "@citation-js/plugin-csl": "^0.8.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "@types/mdx": "^2.0.14",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.16.0",
    "next": "16.2.12",
    "next-intl": "^4.13.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@mermaid-js/parser": "^1.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.12.1",
    "cypress": "^15.19.0",
    "cypress-axe": "^1.7.0",
    "cypress-terminal-report": "^7.3.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "remark-frontmatter": "^5.0.0",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
