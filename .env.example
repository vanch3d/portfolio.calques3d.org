# Environment variable template — copy to .env.local and fill in values
# Do not add real credentials here

# Zotero API
# User ID: found at https://www.zotero.org/settings/keys
# API Key: create at https://www.zotero.org/settings/keys/new (read-only, your library)
# Collection ID: the key of the collection containing all publications (visible in URL when browsing Zotero web)
ZOTERO_USER_ID=
ZOTERO_API_KEY=
ZOTERO_COLLECTION_ID=

# Feature flags (src/lib/flags.ts). Optional: unset means the default in code.
# Read at build/dev start, so restart `pnpm dev` or rebuild after changing one.
# Accepts true|false (also 1|0|on|off|yes|no).
# Sticky chapter rail on case-study chapter pages. Default: true. Set false for the plain "Chapter n of N" label.
NEXT_PUBLIC_FLAG_CHAPTER_RAIL=true
