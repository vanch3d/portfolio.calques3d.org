# Environment variable template — copy to .env.local and fill in values
# Do not add real credentials here

# Zotero API
# User ID: found at https://www.zotero.org/settings/keys
# API Key: create at https://www.zotero.org/settings/keys/new (read-only, your library)
# Collection ID: the key of the collection containing all publications (visible in URL when browsing Zotero web)
ZOTERO_USER_ID=
ZOTERO_API_KEY=
ZOTERO_COLLECTION_ID=
